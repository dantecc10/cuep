# ---------------------------------------------------------------------------
# CUEP · configuración del backend (copia este archivo a .env y ajusta valores)
# ---------------------------------------------------------------------------

# Entorno: development | staging | production
ENVIRONMENT=development

# Conexión a PostgreSQL (driver asyncpg)
DATABASE_URL=postgresql+asyncpg://cuep:CAMBIAR@localhost:5432/cuep

# URL pública del frontend. Se usa para construir el enlace del pase y el QR
# (ejemplo: https://app.example.com/mi-registro?token=...)
PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Firma de los tokens: cadena aleatoria de 32 caracteres o más
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie de refresco (sólo si sirves el frontend y la API en el mismo dominio)
REFRESH_COOKIE_NAME=cuep_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Zona horaria sólo para presentación (los datos se guardan en UTC)
APP_TIMEZONE=America/Mexico_City

# Clave que usa el worker local (header X-Worker-Key)
WORKER_API_KEY=change-this-worker-key

# Orígenes permitidos (JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------------------------------------------------------------------------
# Cloudflare R2 · fotos públicas
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cuep-files
R2_PUBLIC_BASE=

# ---------------------------------------------------------------------------
# Cloudflare R2 · comprobantes de pago (OBLIGATORIO para transferencias)
# ---------------------------------------------------------------------------
# Bucket privado, sin URL pública y con su propio token de lectura/escritura.
# Los comprobantes NUNCA se guardan en el bucket público: si esta variable
# falta, la subida de comprobantes responde 503.
R2_PRIVATE_BUCKET=
# Tamaño máximo del comprobante en bytes (10 MB por defecto)
PAYMENT_PROOF_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# Correo (SMTP) · obligatorio para enviar notificaciones
# ---------------------------------------------------------------------------
# Sin SMTP_HOST el envío falla y las notificaciones quedan en estado "error".
# EMAIL_DEV_MODE=true sólo imprime los correos en la consola y los marca como
# "simulado": úsalo únicamente en desarrollo local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CUEP
EMAIL_DEV_MODE=False

# ---------------------------------------------------------------------------
# Motor de horarios
# ---------------------------------------------------------------------------
SOLVER_TIMEOUT=300

# ---------------------------------------------------------------------------
# 2FA
# ---------------------------------------------------------------------------
# Fernet key; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
